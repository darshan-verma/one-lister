# Shared by apps/web and apps/worker (copy to .env)
NODE_ENV=development
APP_URL=http://localhost:3000
# Host ports 5433 / 6380 avoid clashes with local Homebrew Postgres/Redis on 5432 / 6379
DATABASE_URL=postgresql://onelister:onelister@localhost:5433/onelister
# Base URL for integration tests. Each package appends a suffix to the DB name
# (e.g. onelister_test_db, onelister_test_core) so Turborepo can run tests in parallel.
# Databases are auto-created on first test run.
TEST_DATABASE_URL=postgresql://onelister:onelister@localhost:5433/onelister_test
REDIS_URL=redis://localhost:6380
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-to-a-32char-secret!!
# Optional; defaults to APP_URL
BETTER_AUTH_URL=http://localhost:3000
