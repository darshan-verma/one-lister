{
  "name": "@one-lister/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "seed:inventory": "tsx --env-file=../../.env src/seed-inventory.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@one-lister/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@one-lister/config": "workspace:*",
    "@types/node": "^24.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  }
}
